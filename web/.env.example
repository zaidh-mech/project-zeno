NEXT_PUBLIC_AURA_RECIPIENT=you
# Four-digit viewer PIN. Export again from /admin after changing it.
AURA_GALLERY_PIN=
# Separate admin password (at least 12 characters); never share it with viewers.
AURA_GALLERY_ADMIN_PASSWORD=
# Random secret of at least 32 characters, shared by the server across restarts.
AURA_GALLERY_SESSION_SECRET=
# Optional absolute path to a persistent disk folder for the shared album.
# AURA_GALLERY_DATA_DIR=/var/lib/aura-gallery
NEXT_PUBLIC_AURA_PET_NAME=love
# Optional: JSON array of letters. Each needs a title and body; use \\n between paragraphs.
# NEXT_PUBLIC_AURA_LETTERS='[{"title":"For you","body":"First letter..."},{"title":"Another day","body":"Next letter..."}]'
NEXT_PUBLIC_AURA_SENDER=Your person
NEXT_PUBLIC_AURA_LETTER=Happy birthday, my love!\n\nI made this little place for you. Thank you for being you. I hope today feels as lovely as you deserve.
