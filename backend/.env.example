# Copy values into your shell environment; this file is not loaded automatically.
OPENAI_API_KEY=replace-with-your-server-side-key
AURA_DEVICE_TOKEN=choose-a-long-random-device-secret
AURA_PET_NAME=sunshine
AURA_BIRTHDAY_NOTE=This was made as a birthday gift; celebrate the recipient warmly.
AURA_KNOWN_DETAILS=
AURA_LLM_MODEL=gpt-4.1-mini
AURA_STT_MODEL=gpt-transcribe
AURA_TTS_MODEL=gpt-4o-mini-tts
AURA_TTS_VOICE=coral
# Exact HTTPS origin of the deployed Android web app (no path or trailing slash).
AURA_WEB_ORIGIN=https://example.com
